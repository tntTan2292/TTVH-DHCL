PORTAL_BASE_URL=https://dkcl.vnpost.vn/

# Huế operational account
PORTAL_HUE_USERNAME=
PORTAL_HUE_PASSWORD=
PORTAL_HUE_HRM_CODE=

# Tổng công ty / nationwide account
PORTAL_NATIONAL_USERNAME=
PORTAL_NATIONAL_PASSWORD=

# Huế F1.3 acquisition engine
DKCL_HUE_AUTOMATION_ENABLED=false
DKCL_HUE_HEADLESS=true
DKCL_HUE_MANUAL_AUTH_WAIT_MS=120000
DKCL_HUE_PROFILE_DIR=Data DKCL/BrowserProfiles/HUE
DKCL_HUE_RAW_DOWNLOAD_DIR=portal-downloads/dkcl/hue/f13/raw
DKCL_HUE_GENERATION_POLL_INTERVAL_MS=30000
DKCL_HUE_GENERATION_TIMEOUT_MS=900000
DKCL_HUE_IMPORT_COMPLETION_TIMEOUT_MS=120000

# PERF-LOAD-01: read aggregates from the pre-aggregated day tables. off (default) | shadow | on.
# Per-indicator overrides: QIS_AGG_READ_F41, QIS_AGG_READ_F13, QIS_AGG_READ_F11, QIS_AGG_READ_F12.
# QIS_AGG_READ=off

# AUTO-LOGIN-01: unattended DKCL sign-in and scheduled import. Everything is off by default.
# One automatic sign-in attempt per source, at most once per interval; after the max failures in a row it stops
# until a login succeeds. Credentials are the PORTAL_* values above (TCT may also set PORTAL_NATIONAL_HRM_CODE).
# DKCL_AUTO_LOGIN_HUE_ENABLED=false
# DKCL_AUTO_LOGIN_TCT_ENABLED=false
# DKCL_AUTO_LOGIN_MIN_INTERVAL_MS=1800000
# DKCL_AUTO_LOGIN_MAX_FAILURES=2
# Scheduled import (Vietnam time, comma separated). A missed time runs once at start-up if less than the catch-up late.
# AUTO_IMPORT_SCHEDULE_ENABLED=false
# AUTO_IMPORT_SCHEDULE_TIMES=08:30
# AUTO_IMPORT_SCHEDULE_CATCHUP_MS=10800000
# AUTO_IMPORT_SCHEDULE_SESSION_WAIT_MS=300000
